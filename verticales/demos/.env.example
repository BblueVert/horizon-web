# Copia a .env en el equipo donde corre el bot (mini PC, Mac o VPS). Nunca lo subas al repo.

# ── Fichas publicadas por Claude (horizonweb.cl/api/demos) ──
# El mismo DEMOS_TOKEN que está en Vercel y en el entorno de Claude en la nube.
DEMOS_TOKEN=
DEMOS_API=https://www.horizonweb.cl/api/demos
DEMOS_SYNC_SEG=20

# ── IA ──
DEEPSEEK_API_KEY=
LLM_MODELO=deepseek-v4-flash

# ── Agentes reales que atienden fichas con "motor" (mismo equipo) ──
# Por defecto: mesa-cero=http://localhost:5678/webhook/wa-mesacero-v2 y minimarket=http://localhost:3100/mensaje
MOTORES=
# Si el agente del minimarket tiene AGENTE_TOKEN, el mismo valor aquí
AGENTE_TOKEN=

# ── Bot ──
WA_CARPETA_SESION=./.wa-sesion
# Aviso "así le llega al dueño" cuando se confirma un pedido/reserva: chat | yo | ambos
DEMO_AVISO=chat
# Demo para chats sin demo asignada. Vacío = no responde (recomendado si el número también lo usa gente real).
DEMO_POR_DEFECTO=
# Horas que un chat queda conectado a su demo
DEMO_VENCE_HORAS=72
ESPERA_AGRUPAR_MS=2500
PAUSA_HUMANO_MIN=30
