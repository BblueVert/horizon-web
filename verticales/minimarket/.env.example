# Copia este archivo a .env y completa. Nunca subas el .env al repo.

# ── Base de datos ──
# supabase = producción (proyecto Supabase propio del minimarket) · memoria = pruebas con db/catalogo.json
DB_MODO=supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (capa 1: solo entiende el mensaje) ──
DEEPSEEK_API_KEY=
LLM_MODELO=deepseek-v4-flash
# Para costo por turno en mm_interacciones (USD por millón de tokens y dólar en CLP)
LLM_PRECIO_ENTRADA_USD=0.14
LLM_PRECIO_SALIDA_USD=0.28
DOLAR_CLP=950

# ── Agente HTTP ──
AGENTE_PUERTO=3100
# Clave compartida entre puente y agente (cualquier texto largo y aleatorio)
AGENTE_TOKEN=

# ── Puente WhatsApp (Baileys) ──
AGENTE_URL=http://localhost:3100/mensaje
WA_CARPETA_SESION=./.wa-sesion
# Modo demo: si tiene números (56912345678,56987654321), el bot SOLO responde a esos. Vacío = responde a todos.
SOLO_NUMEROS=
# Junta los mensajes que llegan seguidos antes de responder (ms)
ESPERA_AGRUPAR_MS=2500
# Minutos que el bot se calla en un chat después de que alguien del local escribe a mano
PAUSA_HUMANO_MIN=30
