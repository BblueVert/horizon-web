# ── HORIZON Web — Variables de entorno ────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees .env al repositorio.

# ── Supabase HORIZON (proyecto principal) ─────────────────────────────────────
SUPABASE_URL=https://TU_REF.supabase.co
# OBLIGATORIA: OPS y /api/portal consultan con la anon key + sesión del usuario (RLS)
SUPABASE_ANON_KEY=eyJ...anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key_aqui

# ── n8n Webhooks ───────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://tu-n8n.host/webhook/horizon-leads
N8N_BOOKING_WEBHOOK=https://tu-n8n.host/webhook/booking

# ── DeepSeek (Agente HORIZON — Módulo D) ────────────
# platform.deepseek.com → API Keys. El contexto se envía sin emails/teléfonos/RUT.
DEEPSEEK_API_KEY=sk-...tu_clave_aqui
# DEEPSEEK_MODEL=deepseek-chat

# ── Avances automáticos desde GitHub (/api/ops/ingest) ─
# Secreto compartido con el GitHub Action de cada repo de cliente (secreto HORIZON_INGEST_SECRET allá).
# Genera uno largo: openssl rand -hex 32. Usa SUPABASE_SERVICE_ROLE_KEY (servidor a servidor).
OPS_INGEST_SECRET=

# ── Google Calendar (agenda de reuniones) ─────────────────────────────────────
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//0g...
GOOGLE_CALENDAR_ID=tu_email@gmail.com

# ── Supabase SaaS (proyecto peluquerías — horizon-saas) ───────────────────────
# Solo service_role para endpoints de servidor.
SUPABASE_SAAS_URL=https://TU_SAAS_REF.supabase.co
SUPABASE_SAAS_SERVICE_KEY=eyJ...saas_service_role_key_aqui